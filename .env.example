# Copie este arquivo para .env.local e preencha os valores
# .env.local é ignorado pelo git — nunca commite senhas reais

# ─── MODO LEGADO (apenas desenvolvimento local) ─────────────────────────────
# ⚠️  PA-01/LGPD: VITE_MARKETING_PASS NUNCA deve ser definida em produção.
# O Vite incorpora variáveis VITE_* literalmente no bundle JavaScript público.
# Em produção, configure VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY (abaixo).
# O build aborta automaticamente se VITE_MARKETING_PASS estiver definida
# com NODE_ENV=production (proteção implementada em vite.config.js — PA-01).
VITE_MARKETING_USER=marketing
VITE_MARKETING_PASS=
# Senha compartilhada para acesso de vendedores no modo legado
VITE_VENDEDOR_PASS=

# ─── CREDENCIAIS DE TESTE (E2E / Playwright — nunca em produção) ─────────────
TEST_MARKETING_USER=marketing
TEST_MARKETING_PASS=

# ─── SUPABASE (obrigatório em produção) ──────────────────────────────────────
# Dashboard → Settings → API (veja doc/SUPABASE.md)
# Sem esses valores o app usa localStorage como fallback (modo legado).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
