# Copie este arquivo para .env.local e preencha os valores
# .env.local é ignorado pelo git — nunca commite senhas reais

# Credenciais de acesso ao app
VITE_MARKETING_USER=marketing
VITE_MARKETING_PASS=
VITE_COMERCIAL_USER=comercial
VITE_COMERCIAL_PASS=

# Credenciais de teste (E2E / Playwright)
TEST_MARKETING_USER=marketing
TEST_MARKETING_PASS=
TEST_COMERCIAL_USER=comercial
TEST_COMERCIAL_PASS=

# Supabase — Dashboard → Settings → API (veja SUPABASE.md)
# Sem esses valores o app funciona apenas com armazenamento local (localStorage)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
